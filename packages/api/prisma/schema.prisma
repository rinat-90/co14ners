generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

/// Run with: bun run db:seed  (or: prisma db seed)
/// Prisma will call the command below when `prisma db seed` is invoked.
// prisma seed is configured in package.json under "prisma.seed"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum AchievementType {
  FIRST_SUMMIT
  TEN_SUMMITS
  TWENTY_FIVE_SUMMITS
  ALL_58
  SAWATCH_COMPLETE
  ELK_COMPLETE
  SAN_JUAN_COMPLETE
  SANGRE_DE_CRISTO_COMPLETE
  FRONT_COMPLETE
  TENMILE_MOSQUITO_COMPLETE
  CLASS_4_CLIMBER
  CLASS_5_CLIMBER
  HIGHEST_PEAK
}

enum NotificationType {
  FOLLOW             // someone followed you
  REVIEW_ON_SUMMIT   // someone reviewed a peak you've summited
  COMMENT_ON_REPORT  // someone commented on your trip report
}

/// Yosemite Decimal System class used for Colorado 14er routes
enum Difficulty {
  CLASS_1 // Well-maintained trail, no scrambling
  CLASS_2 // Off-trail, some scrambling on loose rock
  CLASS_3 // Scrambling with exposure, hands needed
  CLASS_4 // Technical scrambling, rope strongly suggested
  CLASS_5 // Technical rock climbing required
}

enum MountainRange {
  SAWATCH
  ELK
  SAN_JUAN
  TENMILE_MOSQUITO
  FRONT
  SANGRE_DE_CRISTO
  OTHER
}

// ─── Core models ──────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  passwordHash        String
  role                Role      @default(USER)
  avatar              String?
  bio                 String?
  resetPasswordToken  String?   @unique
  resetPasswordExpiry DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  reviews            Review[]
  favorites          Favorite[]
  completions        Completion[]
  refreshTokens      RefreshToken[]
  achievements       UserAchievement[]
  tripReports        TripReport[]
  followers          Follow[]          @relation("UserFollowing")
  following          Follow[]          @relation("UserFollowers")
  notifications      Notification[]    @relation("NotificationRecipient")
  actorNotifications Notification[]    @relation("NotificationActor")
  comments           Comment[]
  gearChecklists     GearChecklist[]
  mountainPhotos     MountainPhoto[]   @relation("MountainPhotoUploader")
  pushSubscriptions  PushSubscription[]
  mountainLists      MountainList[]
}

/// In-app notification
model Notification {
  id         String           @id @default(cuid())
  userId     String           // recipient
  actorId    String           // who triggered it
  type       NotificationType
  mountainId String?          // for REVIEW_ON_SUMMIT notifications
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user     User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor    User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  mountain Mountain? @relation(fields: [mountainId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt(sort: Desc)])
}

/// Auto-unlocked badges earned by user activity
model UserAchievement {
  id         String          @id @default(cuid())
  userId     String
  type       AchievementType
  unlockedAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

/// Stored refresh tokens — deleted on logout, rotated on refresh
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Mountain {
  id                 String        @id @default(cuid())
  name               String
  /// Elevation in feet
  altitude           Int
  difficulty         Difficulty
  range              MountainRange
  latitude           Float
  longitude          Float
  description        String?
  /// Starting elevation in feet
  trailheadElevation Int?
  /// Total elevation gain in feet
  elevationGain      Int?
  /// Round-trip distance in miles
  roundTripMiles     Float?
  /// Typical time to complete round-trip in hours
  estimatedHours     Float?
  imageUrl           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  trails         Trail[]
  reviews        Review[]
  favorites      Favorite[]
  completions    Completion[]
  tripReports    TripReport[]
  notifications  Notification[]
  gearChecklists GearChecklist[]
  photos         MountainPhoto[]
  listItems      MountainListItem[]
}

/// Admin-uploaded photos for a mountain; one is flagged isMain → synced to Mountain.imageUrl
model MountainPhoto {
  id         String   @id @default(cuid())
  mountainId String
  uploadedBy String
  url        String   @db.Text
  caption    String?
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())

  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)
  uploader User     @relation("MountainPhotoUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([mountainId])
}

/// A specific named route up a mountain (e.g. "East Ridge", "North Face")
model Trail {
  id                 String     @id @default(cuid())
  mountainId         String
  name               String
  difficulty         Difficulty
  /// Starting elevation in feet
  trailheadElevation Int?
  /// Total elevation gain in feet
  elevationGain      Int?
  /// Round-trip distance in miles
  roundTripMiles     Float?
  /// Typical time to complete round-trip in hours
  estimatedHours     Float?
  description        String?
  imageUrl           String?
  /// GeoJSON LineString — { type: "LineString", coordinates: [[lon, lat], ...] }
  geometry           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  mountain    Mountain     @relation(fields: [mountainId], references: [id], onDelete: Cascade)
  completions Completion[]
  tripReports TripReport[]
}

// ─── User activity models ──────────────────────────────────────────────────────

/// One review per user per mountain; rating is 1–5
model Review {
  id         String    @id @default(cuid())
  userId     String
  mountainId String
  /// Integer rating from 1 (poor) to 5 (excellent)
  rating     Int
  title      String?
  body       String
  /// Date the user actually hiked (may differ from review date)
  hikedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)

  @@unique([userId, mountainId])
}

/// Saved/bookmarked mountains — one per user per mountain
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  mountainId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)

  @@unique([userId, mountainId])
}

/// Detailed trip report written after a summit
model TripReport {
  id          String   @id @default(cuid())
  userId      String
  mountainId  String
  trailId     String?
  title       String
  body        String   @db.Text
  /// Overall conditions: EXCELLENT | GOOD | FAIR | POOR
  conditions  String?
  photoUrl    String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)
  trail    Trail?   @relation(fields: [trailId], references: [id])
  comments Comment[]
}

/// Comment on a trip report
model Comment {
  id           String     @id @default(cuid())
  tripReportId String
  userId       String
  body         String     @db.Text
  createdAt    DateTime   @default(now())

  tripReport TripReport @relation(fields: [tripReportId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripReportId, createdAt])
}

/// Social follow — follower follows following
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

/// Saved gear checklist — checked items per user per mountain
model GearChecklist {
  id         String   @id @default(cuid())
  userId     String
  mountainId String
  /// JSON array of checked item keys
  checked    Json     @default("[]")
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)

  @@unique([userId, mountainId])
}

/// Web Push subscription for browser push notifications
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// User-created named list of mountains (e.g. "2025 Goals", "Done with kids")
model MountainList {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MountainListItem[]

  @@index([userId])
}

model MountainListItem {
  id         String   @id @default(cuid())
  listId     String
  mountainId String
  addedAt    DateTime @default(now())

  list     MountainList @relation(fields: [listId], references: [id], onDelete: Cascade)
  mountain Mountain     @relation(fields: [mountainId], references: [id], onDelete: Cascade)

  @@unique([listId, mountainId])
  @@index([listId])
}

/// A logged summit — users can summit the same mountain multiple times
model Completion {
  id          String    @id @default(cuid())
  userId      String
  mountainId  String
  /// Specific trail used for this summit (optional)
  trailId     String?
  /// When set to true this entry is hidden from other users
  isPrivate   Boolean   @default(false)
  completedAt DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)
  trail    Trail?   @relation(fields: [trailId], references: [id])
}
