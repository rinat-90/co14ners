{
  "name": "@co14ners/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "bun run prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:seed-trails": "bun run prisma/seed-trails.ts",
    "db:fetch-geometry": "bun run src/scripts/fetch-trail-geometry.ts",
    "db:seed-gpx": "bun run prisma/seed-gpx-geometry.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.0",
    "zod": "^3.23.0"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/nodemailer": "^6.4.0",
    "bun-types": "latest",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0"
  }
}
