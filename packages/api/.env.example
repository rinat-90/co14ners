DATABASE_URL="postgresql://postgres:postgres@localhost:5432/co14ners"
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Generate strong secrets: openssl rand -base64 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

APP_URL=http://localhost:3000

# ─── AI features (conditions digest) ──────────────────────────────────────────
# All optional. With no key set the app runs normally and digest endpoints
# return null. Leave AI_PROVIDER blank to use whichever key is present
# (first match wins); set it to pin one: anthropic | gemini | groq | ollama
AI_PROVIDER=

# Paid. Best quality on this task.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Free tier, no credit card: https://console.groq.com/keys
# Structured output needs strict mode, which only the gpt-oss models support.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=  # only to route through a proxy instead of Groq directly
# Requested output tokens count against the per-minute budget before the model
# runs, so the adapter sizes them from this. Raise it after upgrading tiers.
# GROQ_TPM_LIMIT=8000

# Free tier, no credit card: https://aistudio.google.com/apikey
# Quota belongs to the Google Cloud project, and enabling billing on that
# project permanently removes its free tier — use a project you keep unbilled.
# Note: new "AQ."-prefix auth keys are rejected by the Generative Language API
# on some accounts (401 ACCESS_TOKEN_TYPE_UNSUPPORTED) — an AIza key is needed.
GEMINI_API_KEY=
# Free tier covers the Flash / Flash-Lite families only.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=  # only to route through a proxy instead of Google directly

# Free and local, requires AI_PROVIDER=ollama. Weaker at staying grounded, so
# it is a development option rather than a production one.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b

# Optional SMTP for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@co14ners.app
